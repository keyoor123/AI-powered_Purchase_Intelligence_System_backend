# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=purchase_ai

# OpenRouter / LLM Configuration
# Insert your OpenRouter API Key below (get one from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model name to use (defaulting to nvidia/nemotron-nano-12b-v2-vl:free)
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SMTP Configuration for Agent Reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=no-reply@procurement-intelligence.com
